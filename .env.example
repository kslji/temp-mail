# Comma-separated list of domains this service accepts mail for.
# Replace with your real domain once purchased, e.g.: TEMPMAIL_DOMAINS=mytempmail.com,mytempmail.io
TEMPMAIL_DOMAINS=example-temp.test

TEMPMAIL_INBOX_TTL_MINUTES=60
TEMPMAIL_CLEANUP_INTERVAL=60

TEMPMAIL_MONGO_URL=mongodb://localhost:27017/?authSource=admin
TEMPMAIL_MONGO_DB=tempmail

TEMPMAIL_SMTP_HOST=0.0.0.0
TEMPMAIL_SMTP_PORT=1025

TEMPMAIL_API_HOST=0.0.0.0
TEMPMAIL_API_PORT=8000
